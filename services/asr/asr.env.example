ASR_HOST=127.0.0.1
ASR_PORT=8765
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN_ASR_DEVICE=cuda:0
QWEN_ASR_DTYPE=float16
ASR_MAX_AUDIO_BYTES=8388608
ASR_TRANSCRIBE_TIMEOUT=20
ASR_CONCURRENCY=1
# 可留空；服务会优先使用系统 ffmpeg，否则使用 imageio-ffmpeg 内置版本
FFMPEG_BIN=
# 公网 HTTPS 网页直连时需要 WSS，并为浏览器信任的本地证书
ASR_TLS_CERT=
ASR_TLS_KEY=
# 可选：只允许指定网页 Origin；配对令牌通过 WebSocket URL 的 token 参数传入
ASR_ALLOWED_ORIGIN=
ASR_AUTH_TOKEN=
