    "test:orders-concurrency": "node --experimental-strip-types scripts/test-orders-concurrency.mjs",
    "test:orders-d1": "node --experimental-strip-types scripts/test-orders-d1.mjs",
    "test:checkin-d1": "node --experimental-strip-types scripts/test-checkin-d1.mjs",
    "test:data-governance-d1": "node --experimental-strip-types scripts/test-data-governance-d1.mjs",
    "test:handoff-d1": "node --experimental-strip-types scripts/test-handoff-d1.mjs",
    "test:ai-chain-d1": "node --experimental-strip-types scripts/test-ai-chain-d1.mjs",
    "test:settlement-d1": "node --experimental-strip-types scripts/test-settlement-d1.mjs",
    "test:checkin-checkout-loop": "node --experimental-strip-types scripts/test-checkin-checkout-loop.mjs",
