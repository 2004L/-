    "test:invariants": "node scripts/test-invariants.mjs",
    "test:foundation": "node scripts/test-foundation.mjs",
    "test:core-domain": "node scripts/test-core-domain.mjs",
    "test:intents": "node --experimental-strip-types scripts/test-intent-rules.mjs",
    "test:admin-intents": "node --experimental-strip-types scripts/test-admin-intent-rules.mjs",
    "test:admin-credentials": "node --experimental-strip-types scripts/test-admin-credentials.mjs",
