    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:check": "node scripts/check-secrets.mjs && eslint . --ignore-pattern dist --ignore-pattern .next",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "node scripts/test-run-all.mjs",
    "db:generate": "drizzle-kit generate",
    "test:cases": "node scripts/test-cases.mjs",
    "test:replay": "node scripts/test-cases.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "test:room-change-http": "node scripts/test-room-change-http.mjs",
