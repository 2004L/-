    "accept:housekeeping": "node scripts/acceptance-housekeeping.mjs",
    "test:settlement-concurrency": "node --experimental-strip-types scripts/test-settlement-concurrency.mjs",
    "test:schema-drift": "node --experimental-strip-types scripts/test-schema-drift.mjs",
    "test:legacy-projection-d1": "node --experimental-strip-types scripts/test-legacy-projection-d1.mjs",
    "db:audit": "node --experimental-strip-types scripts/db-schema-audit.mjs",
    "test:asr": "node scripts/test-asr-accuracy.mjs",
    "test:security": "node scripts/check-secrets.mjs",
    "mcp:stdio": "node scripts/mcp-server.mjs",
    "test:mcp": "node scripts/test-mcp-readonly.mjs"
